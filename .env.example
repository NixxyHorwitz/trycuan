APP_KEY=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=trycuan
DB_USER=root
DB_PASS=

# Domain shortlink tanpa https://
SHORT_HOST=trycuan.online
# Isi 1 hanya bila server asal menolak koneksi selain dari Cloudflare
TRUST_CLOUDFLARE=0
# Kosong: semua klik ditahan. Kunci uji Cloudflare hanya berlaku di host lokal.
TURNSTILE_SITE=
TURNSTILE_SECRET=

# URL situs. https mengaktifkan paksa HTTPS dan HSTS
APP_URL=https://trycuan.online
# log (hanya lokal, ke storage/logs/mail.log) atau smtp
MAIL_DRIVER=log
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
# tls (STARTTLS, 587) atau ssl (465)
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASS=
# Lokasi mysqldump untuk bin/backup.php
MYSQLDUMP=mysqldump
